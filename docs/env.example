# Copy to .env (or set in your n8n instance) and fill in.
# Shared secret checked by the Tracking workflow's webhook before it acts on a scheduled pass.
PASS_SECRET=change-me-to-a-long-random-string

# n2yo.com API key (free tier). Used by the Scheduling and Status workflows.
# Get one at https://www.n2yo.com/api/  — then paste it wherever you see YOUR_N2YO_API_KEY.
N2YO_API_KEY=YOUR_N2YO_API_KEY
